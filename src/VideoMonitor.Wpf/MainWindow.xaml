<Window x:Class="VideoMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls"
        xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
        xmlns:pages="clr-namespace:VideoMonitor.Wpf.Views.Pages"
        Title="矿山视频监控平台"
        Width="1600" Height="920" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>
    <Grid x:Name="ShellGrid" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FooterRow" Height="30" />
        </Grid.RowDefinitions>
        <Border x:Name="HeaderChrome" Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="17" FontWeight="Bold" Text="M" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="矿山视频监控平台" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="MINING VIDEO OPERATIONS" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,16,0" Padding="10,5"
                            Background="{StaticResource PrimaryBlueMutedBrush}" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource OnlineGreenBrush}" />
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Text="系统在线" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="FullscreenButton"
                            AutomationProperties.AutomationId="MonitorFullscreenButton"
                            Command="{Binding ToggleFullscreenCommand}" Content="全屏"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TreeColumn" Width="304" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavigationChrome" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12,0,14">
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0">
                        <Border Height="1" Margin="0,8" Background="{StaticResource SeparatorBrush}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}"
                                   Text="UI FRAMEWORK  ·  MOCK" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Margin="18,4,0,8" Style="{StaticResource MutedTextStyle}" Text="功能导航" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=实时监控}"
                                Command="{Binding NavigateCommand}" CommandParameter="实时监控"
                                Content="▦   实时监控" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=设备管理}"
                                Command="{Binding NavigateCommand}" CommandParameter="设备管理"
                                Content="◫   设备管理" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=流媒体管理}"
                                Command="{Binding NavigateCommand}" CommandParameter="流媒体管理"
                                Content="◉   流媒体管理" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=录像回放}"
                                Command="{Binding NavigateCommand}" CommandParameter="录像回放"
                                Content="▷   录像回放" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=告警中心}"
                                Command="{Binding NavigateCommand}" CommandParameter="告警中心"
                                Content="△   告警中心" Style="{StaticResource NavigationButtonStyle}" />
                        <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=系统配置}"
                                Command="{Binding NavigateCommand}" CommandParameter="系统配置"
                                Content="⚙   系统配置" Style="{StaticResource NavigationButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <pages:MonitorView x:Name="MonitorContent" Grid.Column="1" DataContext="{Binding Monitor}" />
            <controls:MonitorTree x:Name="TreeChrome" Grid.Column="2" DataContext="{Binding Monitor}" />
        </Grid>
        <controls:StatusBar x:Name="FooterChrome" Grid.Row="2" />
    </Grid>
</Window>
