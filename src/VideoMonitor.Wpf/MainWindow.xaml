<Window x:Class="VideoMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls"
        xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
        xmlns:pages="clr-namespace:VideoMonitor.Wpf.Views.Pages"
        Title="视频监控平台 / ZLMediaKit" Width="1600" Height="920"
        MinWidth="1200" MinHeight="720" WindowStyle="None"
        ResizeMode="CanResize" Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid x:Name="ShellGrid" Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="36" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderChrome" Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="34" Height="34">
                            <Path Data="{StaticResource IconLogo}" Fill="{StaticResource PrimaryBlueMutedBrush}"
                                  Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.4" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="视频监控平台" />
                        <TextBlock Margin="7,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15"
                                   VerticalAlignment="Center" Text="/ ZLMediaKit" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="132" Height="34" Margin="22,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Width="16" Height="16" Data="{StaticResource IconMonitor}" Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.5" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="卸矿站" />
                            <Path Grid.Column="2" Width="8" Height="8" Data="{StaticResource IconChevron}"
                                  Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Stretch="Uniform" RenderTransformOrigin=".5,.5">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <StackPanel Margin="0,0,18,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource OnlineGreenBrush}" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Text="系统运行正常" />
                        </StackPanel>
                        <Border Width="1" Height="26" Margin="0,0,14,0" Background="{StaticResource SeparatorBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="当前站点:" />
                            <TextBlock Margin="7,0,0,0" FontWeight="SemiBold" Text="卸矿站" />
                        </StackPanel>
                        <Button Command="{Binding ToggleFullscreenCommand}" ToolTip="全屏" Style="{StaticResource HeaderToolButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel><Path Width="17" Height="17" Data="{StaticResource IconFullscreen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" FontSize="10" Text="全屏"/></StackPanel>
                        </Button>
                        <Button ToolTip="布局" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel><Path Width="17" Height="17" Data="{StaticResource IconLayout}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" FontSize="10" Text="布局"/></StackPanel>
                        </Button>
                        <Button ToolTip="抓图" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel><Path Width="17" Height="17" Data="{StaticResource IconSnapshot}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" FontSize="10" Text="抓图"/></StackPanel>
                        </Button>
                        <Button ToolTip="告警" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid><StackPanel><Path Width="17" Height="17" Data="{StaticResource IconAlarm}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" FontSize="10" Text="告警"/></StackPanel><Border Margin="27,3,0,0" Width="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{StaticResource DangerRedBrush}" CornerRadius="8"><TextBlock FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Text="3"/></Border></Grid>
                        </Button>
                        <Button ToolTip="设置" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel><Path Width="17" Height="17" Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" FontSize="10" Text="设置"/></StackPanel>
                        </Button>
                        <Border Width="1" Height="26" Margin="4,0" Background="{StaticResource SeparatorBrush}" VerticalAlignment="Center" />
                        <Button Click="MinimizeWindow" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="14" Height="14" Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                        <Button Click="MaximizeWindow" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="13" Height="13" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                        <Button Click="CloseWindow" Style="{StaticResource CloseWindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="13" Height="13" Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TreeColumn" Width="300" />
                </Grid.ColumnDefinitions>
                <Border x:Name="NavigationChrome" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="8,10,8,12">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource NavigationButtonStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Width="17" Height="17" Data="{StaticResource IconStar}" Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="收藏夹"/><Border Grid.Column="2" Padding="6,2" Background="{StaticResource PrimaryBlueMutedBrush}" CornerRadius="9"><TextBlock Foreground="{StaticResource PrimaryBlueBrush}" FontSize="10" Text="12"/></Border></Grid>
                            </Button>
                            <Button Style="{StaticResource NavigationButtonStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="16" Height="16" Data="{StaticResource IconCollapse}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="收起菜单"/></Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=实时监控}" Command="{Binding NavigateCommand}" CommandParameter="实时监控" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconCamera}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="实时监控"/></Grid></Button>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=设备管理}" Command="{Binding NavigateCommand}" CommandParameter="设备管理" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconDevice}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="设备管理"/></Grid></Button>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=流媒体管理}" Command="{Binding NavigateCommand}" CommandParameter="流媒体管理" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconMedia}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="流媒体管理"/></Grid></Button>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=录像回放}" Command="{Binding NavigateCommand}" CommandParameter="录像回放" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconPlayback}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="录像回放"/></Grid></Button>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=告警中心}" Command="{Binding NavigateCommand}" CommandParameter="告警中心" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconAlarm}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="告警中心"/></Grid></Button>
                            <Button Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=系统配置}" Command="{Binding NavigateCommand}" CommandParameter="系统配置" Style="{StaticResource NavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="系统配置"/></Grid></Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <pages:MonitorView x:Name="MonitorContent" Grid.Column="1" DataContext="{Binding Monitor}" />
                <controls:MonitorTree x:Name="TreeChrome" Grid.Column="2" DataContext="{Binding Monitor}" />
            </Grid>
            <controls:StatusBar x:Name="FooterChrome" Grid.Row="2" />
        </Grid>
    </Border>
</Window>
