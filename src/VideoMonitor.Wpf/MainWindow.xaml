<Window x:Class="VideoMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls"
        xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
        xmlns:pages="clr-namespace:VideoMonitor.Wpf.Views.Pages"
        Title="罗河铁矿-620视频管理机" Width="1600" Height="920"
        MinWidth="1200" MinHeight="720" WindowStyle="None"
        ResizeMode="CanResize" Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
        <converters:NavigationVisibilityConverter x:Key="NavigationVisibilityConverter" />
        <Style x:Key="SidebarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NavigationTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarCollapseIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconCollapse}" />
            <Setter Property="Stroke" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid x:Name="ShellGrid" Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="36" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderChrome" Grid.Row="0" Height="{StaticResource AppHeaderHeight}" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="38">
                            <Path Data="{StaticResource IconLogo}" Fill="{StaticResource PrimaryBlueMutedBrush}"
                                  Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.4" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource AppTitleTextStyle}" VerticalAlignment="Center"
                                   Text="罗河铁矿-620视频管理机" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="132" Height="34" Margin="22,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Width="16" Height="16" Data="{StaticResource IconMonitor}" Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.5" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="卸矿站" />
                            <Path Grid.Column="2" Width="8" Height="8" Data="{StaticResource IconChevron}"
                                  Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Stretch="Uniform" RenderTransformOrigin=".5,.5">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <StackPanel Margin="0,0,18,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource OnlineGreenBrush}" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeAuxiliary}" Text="系统运行正常" />
                        </StackPanel>
                        <Border Width="1" Height="26" Margin="0,0,14,0" Background="{StaticResource SeparatorBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource FontSizeAuxiliary}" Text="当前站点:" />
                            <TextBlock Margin="7,0,0,0" FontWeight="SemiBold" Text="卸矿站" />
                        </StackPanel>
                        <Button AutomationProperties.AutomationId="MonitorFullscreenButton" AutomationProperties.Name="全屏"
                                Command="{Binding ToggleFullscreenCommand}" ToolTip="全屏" Style="{StaticResource HeaderToolButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel HorizontalAlignment="Center"><Path Width="19" Height="19" HorizontalAlignment="Center" Data="{StaticResource IconFullscreen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Text="全屏"/></StackPanel>
                        </Button>
                        <Button ToolTip="告警" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="48"><StackPanel HorizontalAlignment="Center"><Path Width="19" Height="19" HorizontalAlignment="Center" Data="{StaticResource IconAlarm}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Text="告警"/></StackPanel><Border Margin="0,1,4,0" Width="17" Height="17" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{StaticResource DangerRedBrush}" CornerRadius="9"><TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Text="3"/></Border></Grid>
                        </Button>
                        <Button ToolTip="设置" Style="{StaticResource HeaderToolButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel HorizontalAlignment="Center"><Path Width="19" Height="19" HorizontalAlignment="Center" Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Text="设置"/></StackPanel>
                        </Button>
                        <Border Width="1" Height="26" Margin="4,0" Background="{StaticResource SeparatorBrush}" VerticalAlignment="Center" />
                        <Button Click="MinimizeWindow" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="14" Height="14" Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                        <Button Click="MaximizeWindow" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="13" Height="13" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                        <Button Click="CloseWindow" Style="{StaticResource CloseWindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="13" Height="13" Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="188" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TreeColumn" Width="300" />
                </Grid.ColumnDefinitions>
                <Border x:Name="NavigationChrome" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="8,10,8,12">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button AutomationProperties.AutomationId="ToggleSidebarButton" ToolTip="展开/收起菜单"
                                    Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SidebarNavigationButtonStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="18" Height="18" Style="{StaticResource SidebarCollapseIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="收起菜单"/></Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <Button ToolTip="实时监控" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=实时监控}" Command="{Binding NavigateCommand}" CommandParameter="实时监控" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconCamera}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="实时监控"/></Grid></Button>
                            <Button ToolTip="设备管理" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=设备管理}" Command="{Binding NavigateCommand}" CommandParameter="设备管理" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconDevice}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="设备管理"/></Grid></Button>
                            <Button ToolTip="流媒体管理" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=流媒体管理}" Command="{Binding NavigateCommand}" CommandParameter="流媒体管理" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconMedia}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="流媒体管理"/></Grid></Button>
                            <Button ToolTip="录像回放" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=录像回放}" Command="{Binding NavigateCommand}" CommandParameter="录像回放" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconPlayback}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="录像回放"/></Grid></Button>
                            <Button ToolTip="告警中心" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=告警中心}" Command="{Binding NavigateCommand}" CommandParameter="告警中心" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconAlarm}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="告警中心"/></Grid></Button>
                            <Button ToolTip="系统配置" Tag="{Binding SelectedNavigation, Converter={StaticResource StringEqualsConverter}, ConverterParameter=系统配置}" Command="{Binding NavigateCommand}" CommandParameter="系统配置" Style="{StaticResource SidebarNavigationButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="19" Height="19" Data="{StaticResource IconSettings}" Style="{StaticResource NavigationIconStyle}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Grid.Column="1" Style="{StaticResource SidebarTextStyle}" Text="系统配置"/></Grid></Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <pages:MonitorView x:Name="MonitorContent" Grid.Column="1" Margin="8,0" DataContext="{Binding Monitor}"
                                   Visibility="{Binding SelectedNavigation, Converter={StaticResource NavigationVisibilityConverter}, ConverterParameter=实时监控}" />
                <controls:MonitorTree x:Name="TreeChrome" Grid.Column="2" Width="{StaticResource MonitorTreeWidth}" DataContext="{Binding Monitor}"
                                      Visibility="{Binding SelectedNavigation, Converter={StaticResource NavigationVisibilityConverter}, ConverterParameter=实时监控}" />
                <pages:DeviceView x:Name="DeviceContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,8,0"
                                  DataContext="{Binding DeviceManagement}"
                                  Visibility="{Binding SelectedNavigation, Converter={StaticResource NavigationVisibilityConverter}, ConverterParameter=设备管理}" />
            </Grid>
            <controls:StatusBar x:Name="FooterChrome" Grid.Row="2" />
        </Grid>
    </Border>
</Window>
