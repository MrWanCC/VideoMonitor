<UserControl x:Class="VideoMonitor.Wpf.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:catalog="clr-namespace:VideoMonitor.Wpf.Catalog"
             Height="{StaticResource StatusBarHeight}" VerticalAlignment="Center">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ServerStateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Connected}">
                    <Setter Property="Foreground" Value="{StaticResource OnlineGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Connecting}">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Unavailable}">
                    <Setter Property="Foreground" Value="{StaticResource WarningOrangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServerStateIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Connected}">
                    <Setter Property="Fill" Value="{StaticResource OnlineGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Connecting}">
                    <Setter Property="Fill" Value="{StaticResource PrimaryBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ServerStatus.State}"
                             Value="{x:Static catalog:ServerConnectionState.Unavailable}">
                    <Setter Property="Fill" Value="{StaticResource WarningOrangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
            <Grid Visibility="{Binding IsCentralServerUiAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" Style="{StaticResource ServerStateIndicatorStyle}" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource FontSizeStatus}" Text="服务器：" />
                    <TextBlock Margin="4,0,0,0" Style="{StaticResource ServerStateTextStyle}"
                               FontSize="{StaticResource FontSizeStatus}" Text="{Binding ServerStatus.StateText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource FontSizeStatus}" Text="最近同步：" />
                    <TextBlock Margin="4,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="{StaticResource FontSizeStatus}" Text="{Binding ServerStatus.LastSuccessfulSyncText}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
