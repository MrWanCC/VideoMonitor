<UserControl x:Class="VideoMonitor.Wpf.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#08131F" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineGreenBrush}" />
                <TextBlock Margin="7,0,0,0" Style="{StaticResource MutedTextStyle}" Text="系统运行正常" />
                <Border Width="1" Height="12" Margin="14,0" Background="{StaticResource SeparatorBrush}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="模拟数据模式" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       Text="NET 8  ·  WPF" />
        </Grid>
    </Border>
</UserControl>
