<UserControl x:Class="VideoMonitor.Wpf.Controls.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
             xmlns:models="clr-namespace:VideoMonitor.Core.Models;assembly=VideoMonitor.Core"
             MinWidth="240" MinHeight="170" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:CameraStatusToTextConverter x:Key="StatusTextConverter" />
        <converters:CameraStatusToBrushConverter x:Key="StatusBrushConverter" />
        <Style x:Key="VideoCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CameraStatus.Warning}">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CameraStatus.Offline}">
                    <Setter Property="BorderBrush" Value="{StaticResource OfflineGrayBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="4" Style="{StaticResource VideoCardStyle}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Height="{StaticResource VideoHeaderHeight}" Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding GroupName, Mode=OneWay}" />
                    <Run Text=" · 通道" />
                    <Run Text="{Binding ChannelNumber, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                             Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}" />
                    <TextBlock Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                               FontSize="{StaticResource FontSizeAuxiliary}"
                               Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource VideoBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.82">
                        <Path Width="50" Height="42" Data="{StaticResource IconCamera}"
                              Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.2" Stretch="Uniform" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold" Text="模拟视频画面" />
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}">
                            <Run Text="CH " /><Run Text="{Binding ChannelNumber, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Border Margin="10" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource OverlayBrush}" CornerRadius="3">
                        <TextBlock FontSize="{StaticResource FontSizeAuxiliary}"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Timestamp}" />
                    </Border>
                    <Border Margin="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{StaticResource OverlayBrush}" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{StaticResource OnlineGreenBrush}" />
                            <TextBlock FontSize="{StaticResource FontSizeAuxiliary}" Text="{Binding Bitrate}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="10" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{StaticResource PrimaryBlueMutedBrush}" BorderBrush="{StaticResource PrimaryBlueBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="{StaticResource FontSizeAuxiliary}"
                                   Foreground="{StaticResource PrimaryBlueBrush}" Text="{Binding StreamType}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
