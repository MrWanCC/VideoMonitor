<UserControl x:Class="VideoMonitor.Wpf.Controls.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
             xmlns:models="clr-namespace:VideoMonitor.Core.Models;assembly=VideoMonitor.Core"
             xmlns:playback="clr-namespace:VideoMonitor.Wpf.Playback"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             MinWidth="240" MinHeight="170" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:CameraStatusToTextConverter x:Key="StatusTextConverter" />
        <converters:CameraStatusToBrushConverter x:Key="StatusBrushConverter" />
        <Style x:Key="VideoCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CameraStatus.Warning}">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CameraStatus.Offline}">
                    <Setter Property="BorderBrush" Value="{StaticResource OfflineGrayBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="4" Style="{StaticResource VideoCardStyle}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Height="{StaticResource VideoHeaderHeight}" Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding GroupName, Mode=OneWay}" />
                    <Run Text=" · 通道" />
                    <Run Text="{Binding ChannelNumber, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                             Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}" />
                    <TextBlock Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                               FontSize="{StaticResource FontSizeAuxiliary}"
                               Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource VideoBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <vlc:VideoView MediaPlayer="{Binding PlaybackSession.MediaPlayer}">
                        <vlc:VideoView.Style>
                            <Style TargetType="vlc:VideoView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}"
                                                 Value="{x:Static playback:PlaybackState.Playing}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </vlc:VideoView.Style>
                        <Grid x:Name="VideoInteractionSurface" Background="#02000000"
                              MouseLeftButtonDown="OnVideoSurfaceMouseLeftButtonDown" />
                    </vlc:VideoView>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}"
                                                 Value="{x:Static playback:PlaybackState.Placeholder}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.82">
                            <Path Width="50" Height="42" Data="{StaticResource IconCamera}"
                                  Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.2" Stretch="Uniform" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold" Text="模拟视频画面" />
                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}">
                                <Run Text="CH " /><Run Text="{Binding ChannelNumber, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}"
                                                 Value="{x:Static playback:PlaybackState.Loading}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Width="44" Height="36" Data="{StaticResource IconCamera}"
                              Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.4" Stretch="Uniform" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Text="正在连接视频..." />
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}" Text="正在等待ZLMediaKit注册流" />
                    </StackPanel>

                    <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}"
                                                 Value="{x:Static playback:PlaybackState.Error}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Width="44" Height="38" Data="{StaticResource IconAlarm}"
                              Stroke="{StaticResource WarningOrangeBrush}" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource WarningOrangeBrush}"
                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Text="{Binding PlaybackErrorTitle, TargetNullValue=拉流失败}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="{StaticResource FontSizeAuxiliary}"
                                   Text="{Binding PlaybackErrorDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
