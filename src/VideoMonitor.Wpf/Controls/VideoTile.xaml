<UserControl x:Class="VideoMonitor.Wpf.Controls.VideoTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters" MinWidth="240" MinHeight="170" SnapsToDevicePixels="True">
    <UserControl.Resources><converters:CameraStatusToTextConverter x:Key="StatusTextConverter"/><converters:CameraStatusToBrushConverter x:Key="StatusBrushConverter"/></UserControl.Resources>
    <Border Margin="4" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
        <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="12,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitleTextStyle}" Text="{Binding CameraName}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/><TextBlock Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" FontSize="11" Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button ToolTip="抓图" Style="{StaticResource IconButtonStyle}"><Path Width="15" Height="15" Data="{StaticResource IconSnapshot}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
                    <Button ToolTip="声音" Style="{StaticResource IconButtonStyle}"><Path Width="15" Height="15" Data="{StaticResource IconSound}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
                    <Button ToolTip="更多" Style="{StaticResource IconButtonStyle}"><Path Width="15" Height="15" Data="{StaticResource IconMore}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/></Button>
                    <Button ToolTip="单画面全屏（预留）" Style="{StaticResource IconButtonStyle}"><Path Width="15" Height="15" Data="{StaticResource IconFullscreen}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource VideoBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.82"><Path Width="46" Height="38" Data="{StaticResource IconCamera}" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.2" Stretch="Uniform"/><TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" Text="模拟视频画面"/><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}"><Run Text="CH "/><Run Text="{Binding ChannelNumber}"/></TextBlock></StackPanel>
                    <Border Margin="10" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource OverlayBrush}" CornerRadius="3"><TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Timestamp}"/></Border>
                    <Border Margin="10" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource OverlayBrush}" CornerRadius="3"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Margin="0,0,6,0" Fill="{StaticResource OnlineGreenBrush}"/><TextBlock FontSize="11" Text="{Binding Bitrate}"/></StackPanel></Border>
                    <Border Margin="10" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBlueMutedBrush}" BorderBrush="{StaticResource SelectedBlueBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontSize="11" Foreground="{StaticResource PrimaryBlueBrush}" Text="{Binding StreamType}"/></Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
