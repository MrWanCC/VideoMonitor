<UserControl x:Class="VideoMonitor.Wpf.Controls.MonitorTree" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TreeRowButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBlueMutedBrush}"/></Trigger><Trigger Property="Tag" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedRowBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="监控设备"/><TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="设备组与固定业务视图"/></StackPanel><Border Grid.Column="1" Width="28" Height="20" Background="{StaticResource PrimaryBlueMutedBrush}" CornerRadius="4"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="10" Text="12"/></Border></Grid></Border>
            <Grid Grid.Row="1" Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Width="15" Height="15" Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Stretch="Uniform"/><TextBox Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource PrimaryBlueBrush}" FontSize="12" Text="搜索设备名称/IP"/></Grid></Border>
                <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="筛选"><Path Width="15" Height="15" Data="{StaticResource IconFilter}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="10,4,10,10" ItemsSource="{Binding TreeSections}">
                    <ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,0,0,4" IsExpanded="True"><Expander.Header><Grid Margin="3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{StaticResource OnlineGreenBrush}"/><TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="在线"/></StackPanel></Grid></Expander.Header>
                        <ItemsControl Margin="13,0,0,5" ItemsSource="{Binding Children}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding IsSelected}" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource TreeRowButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,9,0" Fill="{StaticResource OnlineGreenBrush}"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Name}"/></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource OnlineGreenBrush}" FontSize="10" Text="在线"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Expander></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
