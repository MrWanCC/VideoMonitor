<Window x:Class="VideoMonitor.Wpf.Views.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="服务器设置" Width="560" Height="344"
        MinWidth="560" MinHeight="344" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="FocusAddressInput"
        Closing="WindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="0"
                            CornerRadius="8" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="BusyDisabledTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource IndustrialTextBoxStyle}">
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource SelectedBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource PrimaryBlueMutedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBlueBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource SelectedBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueMutedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BusyDisabledSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BusyDisabledPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusIconContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                    <Setter Property="Background" Value="#2423D66C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                    <Setter Property="Background" Value="#24FF4D4F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCheckIconStyle" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke" Value="{StaticResource OfflineGrayBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Stroke" Value="{StaticResource OnlineGreenBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OnlineGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource OfflineGrayBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource PrimaryBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource OnlineGreenBrush}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource DangerRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Margin="12"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid FocusManager.FocusedElement="{Binding ElementName=ServerBaseUrlTextBox}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="54" Padding="20,0"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30"
                            Background="{StaticResource PrimaryBlueMutedBrush}"
                            BorderBrush="{StaticResource BorderHighlightBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Path Width="17" Height="17" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Data="{StaticResource IconSettings}"
                              Stroke="{StaticResource PrimaryBlueBrush}"
                              StrokeThickness="1.4" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSizePageTitle}"
                                   FontWeight="SemiBold" Text="服务器设置" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Text="配置中心服务连接" />
                    </StackPanel>
                    <Button Grid.Column="2" Width="32" Height="32"
                            AutomationProperties.Name="关闭服务器设置"
                            Click="CloseWindow" Style="{StaticResource CloseWindowButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="13" Height="13" Data="{StaticResource IconClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="SemiBold" Text="服务器地址" />
                <TextBox x:Name="ServerBaseUrlTextBox" Grid.Row="1" Margin="0,8,0,0" Height="38"
                         AutomationProperties.AutomationId="ServerBaseUrlTextBox"
                         AutomationProperties.Name="服务器地址"
                         Style="{StaticResource BusyDisabledTextBoxStyle}"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Margin="0,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Text="支持 HTTP 或 HTTPS，例如 http://127.0.0.1:5000/" />
                <Border Grid.Row="3" x:Name="ConnectionStatusPanel"
                        Margin="0,14,0,0" Padding="12,10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12"
                                Style="{StaticResource StatusIconContainerStyle}">
                            <Grid>
                                <Ellipse x:Name="StatusIndicator" Width="8" Height="8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Style="{StaticResource StatusIndicatorStyle}" />
                                <Path x:Name="StatusCheckIcon" Width="14" Height="14"
                                      Data="{StaticResource IconShield}"
                                      Stretch="Uniform" StrokeThickness="1.35"
                                      Style="{StaticResource StatusCheckIconStyle}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Text="连接状态" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource ConnectionStatusTextStyle}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       Text="{Binding ConnectionStatusText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="24,12"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        AutomationProperties.AutomationId="TestServerConnectionButton"
                        Command="{Binding TestConnectionCommand}"
                        Style="{StaticResource BusyDisabledSecondaryButtonStyle}"
                        Content="测试连接" />
                <Button Margin="0,0,8,0"
                        AutomationProperties.AutomationId="SaveServerSettingsButton"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource BusyDisabledPrimaryButtonStyle}"
                        Content="保存" />
                <Button AutomationProperties.AutomationId="CancelServerSettingsButton"
                        Click="CancelWindow"
                        Style="{StaticResource QuietButtonStyle}"
                        Content="取消" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
