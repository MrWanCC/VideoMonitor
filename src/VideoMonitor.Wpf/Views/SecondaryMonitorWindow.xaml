<Window x:Class="VideoMonitor.Wpf.Views.SecondaryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls"
        xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
        Title="卸矿站监控"
        Width="1440" Height="540" MinWidth="900"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:VideoTile Grid.Column="0" DataContext="{Binding Tiles[0]}" />
        <controls:VideoTile Grid.Column="1" DataContext="{Binding Tiles[1]}" />
        <controls:VideoTile Grid.Column="2" DataContext="{Binding Tiles[2]}" />

        <Border Grid.ColumnSpan="3"
                Panel.ZIndex="10"
                Margin="18,16,0,0"
                Padding="10,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#E60B1927"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="2,0,18,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="卸矿站监控" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="三通道联动视图" />
                </StackPanel>
                <Button Margin="0,0,8,0"
                        Tag="{Binding CurrentGroupName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=2#主溜井}"
                        Command="{Binding SwitchGroupCommand}" CommandParameter="2#主溜井"
                        Content="2#主溜井" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Tag="{Binding CurrentGroupName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=3#主溜井}"
                        Command="{Binding SwitchGroupCommand}" CommandParameter="3#主溜井"
                        Content="3#主溜井" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
