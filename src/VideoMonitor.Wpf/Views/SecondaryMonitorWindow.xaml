<Window x:Class="VideoMonitor.Wpf.Views.SecondaryMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls"
        xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
        Title="罗河铁矿-620视频管理机 - 卸矿站监控" Width="1440" Height="540" MinWidth="900" MinHeight="540" MaxHeight="540"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><converters:StringEqualsConverter x:Key="StringEqualsConverter" /></Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="26" Height="26" VerticalAlignment="Center" Data="{StaticResource IconLogo}" Fill="{StaticResource PrimaryBlueMutedBrush}"
                              Stroke="{StaticResource PrimaryBlueBrush}" StrokeThickness="1.4" Stretch="Uniform" />
                        <TextBlock Margin="10,0,20,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" Text="罗河铁矿-620视频管理机 · 卸矿站监控" />
                        <Button Margin="0,0,8,0" Tag="{Binding CurrentGroupName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=2#主溜井}"
                                Command="{Binding SwitchGroupCommand}" CommandParameter="2#主溜井" Content="2#主溜井"
                                Style="{StaticResource SecondaryButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Tag="{Binding CurrentGroupName, Converter={StaticResource StringEqualsConverter}, ConverterParameter=3#主溜井}"
                                Command="{Binding SwitchGroupCommand}" CommandParameter="3#主溜井" Content="3#主溜井"
                                Style="{StaticResource SecondaryButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource OnlineGreenBrush}" />
                            <TextBlock Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="{StaticResource FontSizeAuxiliary}" Text="系统运行正常" />
                        </StackPanel>
                        <Button Click="MinimizeWindow" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="15" Height="15" Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" />
                        </Button>
                        <Button AutomationProperties.AutomationId="SecondaryMaximizeButton" Click="MaximizeWindow"
                                ToolTip="最大化/还原" Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="14" Height="14" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" />
                        </Button>
                        <Button Click="CloseWindow" Style="{StaticResource CloseWindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="14" Height="14" Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:VideoTile Grid.Column="0" DataContext="{Binding Tiles[0]}" />
                <controls:VideoTile Grid.Column="1" DataContext="{Binding Tiles[1]}" />
                <controls:VideoTile Grid.Column="2" DataContext="{Binding Tiles[2]}" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{StaticResource MutedTextBrush}" Text="当前分组：" />
                        <TextBlock Foreground="{StaticResource PrimaryBlueBrush}" FontSize="{StaticResource FontSizeStatus}" FontWeight="SemiBold" Text="{Binding CurrentGroupName}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="总通道数：3" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource OnlineGreenBrush}" FontSize="{StaticResource FontSizeStatus}" Text="在线通道：3" />
                    <TextBlock x:Name="ClockText" Grid.Column="3" Style="{StaticResource StatusTextStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
