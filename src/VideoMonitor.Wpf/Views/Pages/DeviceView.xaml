<UserControl x:Class="VideoMonitor.Wpf.Views.Pages.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:VideoMonitor.Wpf.Behaviors"
             xmlns:converters="clr-namespace:VideoMonitor.Wpf.Converters"
             xmlns:vm="clr-namespace:VideoMonitor.Wpf.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             PreviewKeyDown="OnDeviceViewPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:DeviceCatalogStatusToTextConverter x:Key="StatusTextConverter" />
        <converters:DeviceCatalogStatusToBrushConverter x:Key="StatusBrushConverter" />
        <converters:FirstChannelNoConverter x:Key="FirstChannelNoConverter" />
        <converters:FirstChannelStreamConverter x:Key="FirstChannelStreamConverter" />
        <converters:StreamTypeToTextConverter x:Key="StreamTypeTextConverter" />
        <converters:MonitorGroupTypeToTextConverter x:Key="MonitorGroupTypeTextConverter" />
        <converters:TransportModeToTextConverter x:Key="TransportModeTextConverter" />
        <Storyboard x:Key="DrawerOpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerTranslate" Storyboard.TargetProperty="X"
                             From="520" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DrawerShade" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.15" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="DrawerCloseStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerTranslate" Storyboard.TargetProperty="X"
                             From="0" To="520" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DrawerShade" Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Style x:Key="DeviceFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeAuxiliary}" />
        </Style>
        <Style x:Key="DeviceSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeVideoTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DeviceGroupSectionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBlueMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceGroupRowStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,1,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueMutedBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DeviceLayout" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" Text="设备分组" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="按业务分类管理监控设备" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="72" Height="30" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AddRootCategoryButton"
                            Command="{Binding BeginAddRootCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="新增分类"
                            Visibility="{Binding IsRootManagementAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GroupSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Grid.ColumnSpan="3"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Style="{StaticResource DeviceGroupSectionToggleStyle}"
                                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ToggleButton.ContextMenu>
                                                <ContextMenu Background="{StaticResource PanelBackgroundBrush}"
                                                             BorderBrush="{StaticResource BorderBrush}"
                                                             BorderThickness="1"
                                                             Padding="0">
                                                    <ContextMenu.Resources>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                            <Setter Property="Padding" Value="12,6" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <Border x:Name="Chrome"
                                                                                Background="{TemplateBinding Background}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter ContentSource="Header"
                                                                                              HorizontalAlignment="Left"
                                                                                              VerticalAlignment="Center"
                                                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                                <Setter TargetName="Chrome" Property="Background"
                                                                                        Value="{StaticResource SelectedBlueBrush}" />
                                                                                <Setter Property="Foreground"
                                                                                        Value="{StaticResource PrimaryTextBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter Property="Opacity" Value="0.55" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ContextMenu.Resources>
                                                    <MenuItem Header="编辑"
                                                              Command="{Binding PlacementTarget.Tag.BeginEditRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext.CatalogGroup.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.IsRootManagementAvailable, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <MenuItem Header="删除"
                                                              Command="{Binding PlacementTarget.Tag.DeleteRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext.CatalogGroup.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.IsRootManagementAvailable, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </ContextMenu>
                                            </ToggleButton.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Width="9" Height="9" Data="{StaticResource IconChevron}"
                                                      Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.7"
                                                      Stretch="Uniform" RenderTransformOrigin=".5,.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TreeSectionTextStyle}"
                                                            Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource FontSizeCaption}"
                                                           Text="{Binding Children.Count, StringFormat=({0})}" />
                                            </Grid>
                                        </ToggleButton>
                                        <Button Grid.Column="3" Width="30" Height="30" ToolTip="新建分组"
                                                Command="{Binding DataContext.BeginAddGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ActiveGroup}" Style="{StaticResource IconButtonStyle}">
                                            <Path Width="15" Height="15" Data="{StaticResource IconAdd}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Children}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:Name="GroupRow" Style="{StaticResource DeviceGroupRowStyle}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding Tag.SelectGroupCommand, RelativeSource={RelativeSource Self}}"
                                                        CommandParameter="{Binding ActiveGroup}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="{StaticResource PanelBackgroundBrush}"
                                                                     BorderBrush="{StaticResource BorderBrush}"
                                                                     BorderThickness="1"
                                                                     Padding="0">
                                                            <ContextMenu.Resources>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                                    <Setter Property="Padding" Value="12,6" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="MenuItem">
                                                                                <Border x:Name="Chrome"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter ContentSource="Header"
                                                                                                      HorizontalAlignment="Left"
                                                                                                      VerticalAlignment="Center"
                                                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                                        <Setter TargetName="Chrome"
                                                                                                Property="Background"
                                                                                                Value="{StaticResource SelectedBlueBrush}" />
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{StaticResource PrimaryTextBrush}" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                                        <Setter Property="Opacity" Value="0.55" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ContextMenu.Resources>
                                                            <MenuItem Header="重命名"
                                                                      Command="{Binding PlacementTarget.Tag.BeginRenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext.ActiveGroup, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="删除"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                       CommandParameter="{Binding PlacementTarget.DataContext.ActiveGroup, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid Margin="10,0,5,0">
                                                        <Grid Margin="5,0,0,0" IsHitTestVisible="False">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="15" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineGreenBrush}" />
                                                            <TextBlock x:Name="GroupNameText" Grid.Column="1" Margin="7,0,0,0"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                                                                        FontSize="{StaticResource FontSizeTreeItem}" Text="{Binding Name}" />
                                                        </Grid>
                                                        <TextBox x:Name="GroupNameEditor" Height="32" Margin="18,1,0,1"
                                                                 Style="{StaticResource IndustrialTextBoxStyle}"
                                                                 Text="{Binding DataContext.EditingGroupName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="Collapsed" Loaded="OnGroupEditorLoaded"
                                                                 KeyDown="OnGroupEditorKeyDown" LostFocus="OnGroupEditorLostFocus" />
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="GroupRow" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                                        <Setter TargetName="GroupRow" Property="BorderBrush" Value="{StaticResource BorderHighlightBrush}" />
                                                        <Setter TargetName="GroupNameText" Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter TargetName="GroupNameText" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="GroupNameEditor" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="4,8,4,0">
                    <TextBlock Foreground="{StaticResource WarningOrangeBrush}"
                               FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Text="{Binding GroupEditError}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource WarningOrangeBrush}"
                               FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Text="{Binding RootEditError}" />
                </StackPanel>
                <Border Grid.RowSpan="3" Panel.ZIndex="30" Padding="12"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderHighlightBrush}" BorderThickness="1"
                        Visibility="{Binding IsRootEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSizeVideoTitle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" Text="根分类" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource MutedTextStyle}"
                                   Text="配置监控设备的业务分类" />
                        <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="分类名称 *" />
                        <TextBox AutomationProperties.AutomationId="RootCategoryNameTextBox"
                                 Style="{StaticResource IndustrialTextBoxStyle}"
                                 Text="{Binding RootEditName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,6" Style="{StaticResource DeviceFieldLabelStyle}" Text="分类类型 *" />
                        <ComboBox AutomationProperties.AutomationId="RootCategoryKindComboBox"
                                  Style="{StaticResource IndustrialComboBoxStyle}"
                                  ItemsSource="{Binding RootKindOptions}"
                                  SelectedItem="{Binding RootEditKind, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditRootKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource MonitorGroupTypeTextConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource WarningOrangeBrush}"
                                   TextWrapping="Wrap" Text="{Binding RootEditError}" />
                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="64" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="CancelRootCategoryButton"
                                    Command="{Binding CancelRootEditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Content="取消" />
                            <Button Width="64" AutomationProperties.AutomationId="SaveRootCategoryButton"
                                    Command="{Binding SaveRootCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Content="保存" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="当前分组：" />
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold"
                                        Text="{Binding ActiveSelectedGroupName}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="设备列表按物理摄像机展示" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="0,0,12,0" Height="36" VerticalAlignment="Center"
                            Command="{Binding AddDeviceCommand}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Margin="0,0,7,0" Data="{StaticResource IconAdd}"
                                  Stroke="White" StrokeThickness="1.8" Stretch="Uniform" />
                            <TextBlock Foreground="White" FontWeight="SemiBold" Text="新建设备" />
                        </StackPanel>
                    </Button>
                    <Grid Grid.Column="2" Height="36" VerticalAlignment="Center">
                        <TextBox Padding="34,0,10,0" Style="{StaticResource IndustrialTextBoxStyle}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Path Width="16" Height="16" Margin="11,0,0,0" HorizontalAlignment="Left"
                              Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedTextBrush}"
                              StrokeThickness="1.5" Stretch="Uniform" IsHitTestVisible="False" />
                        <TextBlock Margin="34,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                   Text="搜索设备名称 / IP" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SearchKeyword}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="960" Margin="12,0,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="5,5,0,0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="75" /><ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="65" /><ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="82" /><ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DeviceListHeaderTextStyle}" Text="设备名称" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DeviceListHeaderTextStyle}" Text="IP地址" />
                                <TextBlock Grid.Column="2" Style="{StaticResource DeviceListHeaderTextStyle}" Text="SDK端口" />
                                <TextBlock Grid.Column="3" Style="{StaticResource DeviceListHeaderTextStyle}" Text="RTSP端口" />
                                <TextBlock Grid.Column="4" Style="{StaticResource DeviceListHeaderTextStyle}" Text="主通道" />
                                <TextBlock Grid.Column="5" Style="{StaticResource DeviceListHeaderTextStyle}" Text="码流" />
                                <TextBlock Grid.Column="6" Style="{StaticResource DeviceListHeaderTextStyle}" Text="传输方式" />
                                <TextBlock Grid.Column="7" Style="{StaticResource DeviceListHeaderTextStyle}" Text="状态" />
                                <TextBlock Grid.Column="8" HorizontalAlignment="Center" Style="{StaticResource DeviceListHeaderTextStyle}" Text="操作" />
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="52" Margin="0,0,0,4" Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                        <Grid Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="75" /><ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="65" /><ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="82" /><ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding IpAddress}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding SdkPort}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding RtspPort}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Converter={StaticResource FirstChannelNoConverter}}" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Converter={StaticResource FirstChannelStreamConverter}}" />
                                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding TransportMode, Converter={StaticResource TransportModeTextConverter}}" />
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Converter={StaticResource StatusBrushConverter}}" />
                                                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Converter={StaticResource StatusBrushConverter}}"
                                                           Text="{Binding Converter={StaticResource StatusTextConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="8" HorizontalAlignment="Center" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource DeviceActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal"><Path Width="13" Height="13" Margin="0,0,5,0" Data="{StaticResource IconEdit}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="编辑"/></StackPanel>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource DeviceActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal"><Path Width="13" Height="13" Margin="0,0,5,0" Data="{StaticResource IconDelete}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="删除"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="DrawerShade" Grid.Column="1" Margin="8,0,0,0" Panel.ZIndex="10"
                Background="#FF000000" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="EditorDrawer" Grid.Column="1" Width="520" HorizontalAlignment="Right" Panel.ZIndex="20"
                Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="520" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="66" />
                </Grid.RowDefinitions>
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" Text="{Binding EditorTitle}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Command="{Binding CancelEditCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="关闭">
                        <Path Width="14" Height="14" Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,4,18,18">
                        <TextBlock Style="{StaticResource DeviceSectionTitleStyle}" Text="基础信息" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="设备名称 *" />
                                <TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="所属分组 *" />
                                <ComboBox x:Name="GroupSelector" Style="{StaticResource IndustrialComboBoxStyle}"
                                          ItemsSource="{Binding ActiveEditableGroups}" SelectedValuePath="Id"
                                          SelectedValue="{Binding EditDraft.GroupId, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="厂家"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.Manufacturer, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="型号"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.Model, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Border Height="1" Margin="0,0,0,12" Background="{StaticResource SeparatorBrush}" />
                        <TextBlock Style="{StaticResource DeviceSectionTitleStyle}" Text="接入参数" />
                        <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="设备IP *" />
                        <TextBox Margin="0,0,0,12" Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="SDK端口"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.SdkPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="RTSP端口"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.RtspPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="用户名" />
                                <TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="密码" />
                                <PasswordBox Style="{StaticResource IndustrialPasswordBoxStyle}"
                                             behaviors:PasswordBoxBinding.BoundPassword="{Binding EditDraft.Password, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,0,0,12" Background="{StaticResource SeparatorBrush}" />
                        <TextBlock Style="{StaticResource DeviceSectionTitleStyle}" Text="通道与传输配置" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="通道号"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.ChannelNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="通道名称"/><TextBox Style="{StaticResource IndustrialTextBoxStyle}" Text="{Binding EditDraft.ChannelName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="码流类型" />
                                <ComboBox Style="{StaticResource IndustrialComboBoxStyle}"
                                          ItemsSource="{Binding StreamTypes}" SelectedItem="{Binding EditDraft.StreamType}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource StreamTypeTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DeviceFieldLabelStyle}" Text="传输方式" />
                                <ComboBox Style="{StaticResource IndustrialComboBoxStyle}"
                                          ItemsSource="{Binding TransportModes}" SelectedItem="{Binding EditDraft.TransportMode}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource TransportModeTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,0,0,12" Background="{StaticResource SeparatorBrush}" />
                        <TextBlock Style="{StaticResource DeviceSectionTitleStyle}" Text="RTSP信息" />
                        <Border Padding="10" Background="{StaticResource VideoBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="5">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                                       Text="{Binding EditDraft.RtspPreview}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource WarningOrangeBrush}"
                                   FontSize="{StaticResource FontSizeAuxiliary}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource WarningOrangeBrush}"
                                   FontSize="{StaticResource FontSizeAuxiliary}" Text="{Binding OperationError}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Panel.ZIndex="2" IsHitTestVisible="False">
                    <Border Width="240" Height="135" Margin="0,0,18,18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="Black" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestPreview.State}" Value="Playing">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <vlc:VideoView MediaPlayer="{Binding TestPreview.MediaPlayer}" />
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="18,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding TestPreview.StatusText}" TextWrapping="Wrap" MaxWidth="180" />
                        <Button Margin="0,0,10,0" Command="{Binding TestStreamCommand}" Content="测试视频">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestPreview.State}" Value="{x:Static vm:TestPreviewState.Idle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TestPreview.State}" Value="{x:Static vm:TestPreviewState.Failure}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="0,0,10,0" Command="{Binding TestPreview.StopCommand}" Content="停止测试">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestPreview.State}" Value="{x:Static vm:TestPreviewState.Playing}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TestPreview.State}" Value="{x:Static vm:TestPreviewState.Failure}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="0,0,10,0" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="取消" />
                        <Button Command="{Binding SaveDeviceCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="保存" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="2" Panel.ZIndex="50" Background="#B807111D"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" Text="操作提示" />
                    <TextBlock Margin="0,14,0,22" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="{StaticResource FontSizeBody}" LineHeight="22" Text="{Binding DialogMessage}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Right" Command="{Binding CancelDialogCommand}" Content="知道了">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogMode}" Value="{x:Static vm:DeviceDialogMode.Information}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogMode}" Value="{x:Static vm:DeviceDialogMode.Confirmation}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Margin="0,0,10,0" Command="{Binding CancelDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="取消" />
                        <Button Command="{Binding ConfirmDialogCommand}" Background="{StaticResource DangerRedBrush}"
                                Style="{StaticResource PrimaryButtonStyle}" Content="确认删除" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
