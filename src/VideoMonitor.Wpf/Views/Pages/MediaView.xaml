<UserControl x:Class="VideoMonitor.Wpf.Views.Pages.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:VideoMonitor.Wpf.Behaviors"
             IsVisibleChanged="OnIsVisibleChanged">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="流媒体设置" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SecondaryTextStyle}" Text="ZLM API 地址" />
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding ZlmApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="播放地址" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding PlaybackBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="VHost" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding Vhost, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="正式 App" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding FormalApp, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="测试 App" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding TestApp, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="ZLM Secret" />
            <PasswordBox Grid.Row="5" Grid.Column="1" Margin="0,12,0,0"
                         behaviors:PasswordBoxBinding.BoundPassword="{Binding ZlmSecret, Mode=TwoWay}" />

            <TextBlock Grid.Row="6" Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}" Text="无读者延迟（秒）" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource IndustrialTextBoxStyle}"
                     Text="{Binding NoReaderGraceSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,16,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="当前版本：" />
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Revision}" />
                <TextBlock Margin="16,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="已保存 Secret：" />
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding HasSecret}" />
            </StackPanel>

            <Border Grid.Row="8" Grid.ColumnSpan="2" Margin="0,20,0,0"
                    Padding="14" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                    DataContext="{Binding PageViewModel.Diagnostics, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="媒体诊断" />
                        <TextBlock Margin="18,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="服务：" />
                        <TextBlock Margin="4,2,0,0" Text="{Binding ServerHealth}" />
                        <TextBlock Margin="18,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="活动流：" />
                        <TextBlock Margin="4,2,0,0" Text="{Binding ActiveStreamCount}" />
                        <TextBlock Margin="18,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="观看者：" />
                        <TextBlock Margin="4,2,0,0" Text="{Binding ViewerCount}" />
                        <TextBlock Margin="18,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="故障：" />
                        <TextBlock Margin="4,2,0,0" Text="{Binding FaultCount}" />
                        <TextBlock Margin="18,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding StatusText}" />
                        <Button Margin="18,0,0,0" Command="{Binding RefreshCommand}" Content="刷新诊断" />
                    </StackPanel>

                    <ScrollViewer Margin="0,12,0,0" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Streams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DeviceName}" />
                                                <TextBlock Margin="8,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding ChannelName}" />
                                                <TextBlock Margin="8,0,0,0" Text="通道" />
                                                <TextBlock Margin="4,0,0,0" Text="{Binding ChannelNo}" />
                                                <TextBlock Margin="12,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding SafeLastErrorMessage}" />
                                                <TextBlock Margin="12,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="陈旧：" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding IsStale}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="{Binding StreamTypeText}" />
                                            <TextBlock Grid.Column="2" Margin="16,0,0,0" Text="{Binding RuntimeState}" />
                                            <TextBlock Grid.Column="3" Margin="16,0,0,0" Text="{Binding ViewerCount}" />
                                            <Button Grid.Column="4" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Content="重试"
                                                    IsEnabled="{Binding CanRetry}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="20,12" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88" Command="{Binding TestCommand}" Content="测试" />
                <Button MinWidth="88" Margin="10,0,0,0" Command="{Binding SaveCommand}" Content="保存" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
