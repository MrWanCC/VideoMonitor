<UserControl x:Class="VideoMonitor.Wpf.Views.Pages.MonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls">
    <Grid Background="{StaticResource WindowBackgroundBrush}"><Grid.RowDefinitions><RowDefinition x:Name="MonitorHeaderRow" Height="48"/><RowDefinition Height="*"/><RowDefinition x:Name="DetailRow" Height="132"/></Grid.RowDefinitions>
        <Border x:Name="MonitorHeader" Margin="8,6,8,4" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Width="16" Height="16" Data="{StaticResource IconMonitor}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="8,0" Style="{StaticResource SecondaryTextStyle}" Text="溜井监控"/><Path Width="7" Height="7" Data="{StaticResource IconChevron}" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Stretch="Uniform"/><TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding CurrentChuteName}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButtonStyle}" ToolTip="抓图"><Path Width="15" Height="15" Data="{StaticResource IconSnapshot}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button><Button Margin="4,0,0,0" Style="{StaticResource IconButtonStyle}" ToolTip="2×2布局"><Path Width="15" Height="15" Data="{StaticResource IconLayout}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/></Button><Border Margin="6,0,0,0" Padding="10,5" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"><TextBlock FontSize="12" Text="2×2"/></Border></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="4,0,4,2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:VideoTile Grid.Row="0" Grid.Column="0" DataContext="{Binding MainTiles[0]}"/><controls:VideoTile Grid.Row="0" Grid.Column="1" DataContext="{Binding MainTiles[1]}"/><controls:VideoTile Grid.Row="1" Grid.Column="0" DataContext="{Binding MainTiles[2]}"/><controls:VideoTile Grid.Row="1" Grid.Column="1" DataContext="{Binding MainTiles[3]}"/></Grid>
        <Border x:Name="DetailPanel" Grid.Row="2" Margin="8,2,8,8" Style="{StaticResource PanelBorderStyle}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" Text="设备信息"/><Border Width="1" Height="14" Margin="12,0" Background="{StaticResource SeparatorBrush}"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="当前溜井："/><TextBlock Margin="3,0,14,0" FontWeight="SemiBold" Text="{Binding CurrentChuteName}"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="当前巷道："/><TextBlock Margin="3,0,0,0" FontWeight="SemiBold" Text="{Binding CurrentTunnelName}"/></StackPanel><Button Grid.Column="1" Click="ToggleDetailPanel" Style="{StaticResource IconButtonStyle}" ToolTip="折叠详情"><Path x:Name="DetailChevron" Width="12" Height="12" Data="{StaticResource IconChevron}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform></Path></Button></Grid>
                <Grid Grid.Row="1" Margin="12,2,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource MutedTextStyle}" Text="摄像头名称"/><TextBlock Margin="0,4,0,0" Text="{Binding MainTiles[0].CameraName}"/><TextBlock Margin="0,7,0,0" Style="{StaticResource MutedTextStyle}" Text="IP 地址"/><TextBlock Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="192.168.17.5"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource MutedTextStyle}" Text="通道 / 在线状态"/><StackPanel Margin="0,4,0,0" Orientation="Horizontal"><TextBlock Text="{Binding MainTiles[0].ChannelNumber, StringFormat=通道{0}}"/><Ellipse Width="6" Height="6" Margin="14,0,6,0" Fill="{StaticResource OnlineGreenBrush}"/><TextBlock Foreground="{StaticResource OnlineGreenBrush}" Text="在线"/></StackPanel><TextBlock Margin="0,7,0,0" Style="{StaticResource MutedTextStyle}" Text="码率 / 分辨率"/><TextBlock Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}"><Run Text="{Binding MainTiles[0].Bitrate}"/><Run Text="  ·  1920×1080"/></TextBlock></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource MutedTextStyle}" Text="码流类型"/><TextBlock Margin="0,4,0,0" Text="{Binding MainTiles[0].StreamType}"/><TextBlock Margin="0,7,0,0" Style="{StaticResource MutedTextStyle}" Text="更新时间"/><TextBlock Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding MainTiles[0].Timestamp}"/></StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
