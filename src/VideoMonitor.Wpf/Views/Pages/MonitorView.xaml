<UserControl x:Class="VideoMonitor.Wpf.Views.Pages.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VideoMonitor.Wpf.Controls">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="实时视频" />
                <Border Margin="10,0,0,0" Padding="7,3" Background="{StaticResource PrimaryBlueMutedBrush}" CornerRadius="4">
                    <TextBlock Foreground="{StaticResource PrimaryBlueBrush}" FontSize="10" Text="固定 3+1 业务视图" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,14,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="溜井" />
                <TextBlock Margin="7,0,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" Text="{Binding CurrentChuteName}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="巷道" />
                <TextBlock Margin="7,0,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" Text="{Binding CurrentTunnelName}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="7,0,7,7">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:VideoTile Grid.Row="0" Grid.Column="0" DataContext="{Binding MainTiles[0]}" />
            <controls:VideoTile Grid.Row="0" Grid.Column="1" DataContext="{Binding MainTiles[1]}" />
            <controls:VideoTile Grid.Row="1" Grid.Column="0" DataContext="{Binding MainTiles[2]}" />
            <controls:VideoTile Grid.Row="1" Grid.Column="1" DataContext="{Binding MainTiles[3]}" />
        </Grid>
    </Grid>
</UserControl>
