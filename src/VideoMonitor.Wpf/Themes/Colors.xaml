<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundMain">#07111D</Color>
    <Color x:Key="BackgroundSidebar">#091522</Color>
    <Color x:Key="BackgroundPanel">#0B1724</Color>
    <Color x:Key="BackgroundCard">#0A1622</Color>
    <Color x:Key="BackgroundVideo">#020A12</Color>
    <Color x:Key="BorderDefault">#17334D</Color>
    <Color x:Key="BorderSubtle">#10283C</Color>
    <Color x:Key="Primary">#1687FF</Color>
    <Color x:Key="PrimaryHover">#2693FF</Color>
    <Color x:Key="PrimarySelected">#0D5EA8</Color>
    <Color x:Key="Online">#23D66C</Color>
    <Color x:Key="Warning">#FF9800</Color>
    <Color x:Key="Offline">#77838E</Color>
    <Color x:Key="Danger">#FF4D4F</Color>
    <Color x:Key="TextPrimary">#EEF4FA</Color>
    <Color x:Key="TextSecondary">#A4B1BE</Color>
    <Color x:Key="TextMuted">#687887</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundMain}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource BackgroundSidebar}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource BackgroundPanel}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource BackgroundCard}" />
    <SolidColorBrush x:Key="VideoBackgroundBrush" Color="{StaticResource BackgroundVideo}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderDefault}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource PrimarySelected}" />
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}" />
    <SolidColorBrush x:Key="SelectedBlueBrush" Color="{StaticResource PrimarySelected}" />
    <SolidColorBrush x:Key="PrimaryBlueMutedBrush" Color="#331687FF" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#401687FF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC07111D" />
    <SolidColorBrush x:Key="OnlineGreenBrush" Color="{StaticResource Online}" />
    <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="OfflineGrayBrush" Color="{StaticResource Offline}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextMuted}" />
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="Spacing8">8</Thickness>
    <Thickness x:Key="Spacing12">12</Thickness>
    <Thickness x:Key="Spacing16">16</Thickness>
    <Thickness x:Key="Spacing24">24</Thickness>
</ResourceDictionary>
